<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!--
        Passkey tables for Spring Security's JDBC WebAuthn repositories, with the same columns as
        spring-security-web 7.1.1 (user-entities-schema.sql, user-credentials-schema-postgres.sql).
        user_entities.name is the owner's email.
    -->
    <changeSet id="004-webauthn" author="welcome-home">
        <comment>Passkey tables for Spring Security WebAuthn.</comment>

        <createTable tableName="user_entities">
            <column name="id" type="varchar(1000)">
                <constraints primaryKey="true" primaryKeyName="user_entities_pkey"/>
            </column>
            <column name="name" type="varchar(100)">
                <constraints nullable="false"/>
            </column>
            <column name="display_name" type="varchar(200)"/>
        </createTable>

        <createTable tableName="user_credentials">
            <column name="credential_id" type="varchar(1000)">
                <constraints primaryKey="true" primaryKeyName="user_credentials_pkey"/>
            </column>
            <column name="user_entity_user_id" type="varchar(1000)">
                <constraints nullable="false"/>
            </column>
            <column name="public_key" type="bytea">
                <constraints nullable="false"/>
            </column>
            <column name="signature_count" type="bigint"/>
            <column name="uv_initialized" type="boolean"/>
            <column name="backup_eligible" type="boolean">
                <constraints nullable="false"/>
            </column>
            <column name="authenticator_transports" type="varchar(1000)"/>
            <column name="public_key_credential_type" type="varchar(100)"/>
            <column name="backup_state" type="boolean">
                <constraints nullable="false"/>
            </column>
            <column name="attestation_object" type="bytea"/>
            <column name="attestation_client_data_json" type="bytea"/>
            <column name="created" type="timestamp"/>
            <column name="last_used" type="timestamp"/>
            <column name="label" type="varchar(1000)">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <sql>
            GRANT SELECT, INSERT, UPDATE, DELETE ON user_entities, user_credentials TO app_user;
        </sql>
    </changeSet>

</databaseChangeLog>
