<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!--
        Owners connect Nuki only by authorizing welcome-home's OAuth2 client: a pasted API token is no longer taken,
        so every connection has a refresh token and an expiry, and how it was made needs no column.

        Not backward compatible, and so the first changeset of major version 3: a connection made with a pasted API
        token is deleted, its owner connects again, and a 2.x release, which reads credential, does not run against
        this schema. Going back is restoring a dump from before it.
    -->
    <changeSet id="039-nuki-connection-oauth2-only" author="welcome-home">
        <comment>
            Deletes the connections made with a pasted API token, and takes out the column that told them apart.
        </comment>
        <sql>
            DELETE FROM nuki_connection WHERE credential &lt;&gt; 'OAUTH2';
            ALTER TABLE nuki_connection DROP CONSTRAINT nuki_connection_credential_check;
        </sql>
        <dropColumn tableName="nuki_connection" columnName="credential"/>
        <addNotNullConstraint tableName="nuki_connection" columnName="refresh_token_encrypted"/>
        <addNotNullConstraint tableName="nuki_connection" columnName="access_token_expires_at"/>
    </changeSet>

</databaseChangeLog>
