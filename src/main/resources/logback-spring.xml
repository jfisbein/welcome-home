<?xml version="1.0" encoding="UTF-8"?>
<!-- Spring Boot's console logging, with guests' tokens masked in every message. -->
<configuration>
    <conversionRule conversionWord="m" class="welcomehome.access.logging.GuestTokenMaskingConverter"/>
    <conversionRule conversionWord="msg" class="welcomehome.access.logging.GuestTokenMaskingConverter"/>
    <conversionRule conversionWord="message" class="welcomehome.access.logging.GuestTokenMaskingConverter"/>
    <include resource="org/springframework/boot/logging/logback/defaults.xml"/>
    <include resource="org/springframework/boot/logging/logback/console-appender.xml"/>
    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
    </root>
</configuration>
